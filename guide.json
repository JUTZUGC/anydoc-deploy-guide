    "deploy": {
      "type": "script",
      "requires": [
        "node"
      ],
      "steps": [
        "npm install -g @firecrawl/anydoc",
        "anydoc --help | head -n 20",
        "echo '安装完成：anydoc report.docx -o report.md'"
      ],
      "stepsPs": [
        "npm.cmd install -g @firecrawl/anydoc",
        "anydoc --help",
        "Write-Host '安装完成：anydoc report.docx -o report.md'"
      ],
      "source": "https://github.com/firecrawl/anydoc#usage"
    },
    "pitfalls": [
      "首次运行慢：正在下载预编译二进制",
      "命令找不到：确认 npm 全局 bin 在 PATH",
      "扫描 PDF 输出空：加 `--ocr hosted` 并配 Key",
      "中文乱码：源文件编码有问题，先另存 UTF-8",
      "表格错位：复杂表格转完要人工校对",
      "离线环境：提前缓存二进制或改用 Node 绑定"
    ]
  },
